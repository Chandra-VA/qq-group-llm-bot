# NapCat: WebSocket server (NOT WebSocket client), local machine only.
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=
# Required: comma-separated QQ group numbers; empty means reply nowhere.
ALLOWED_GROUPS=

# Chat Completions-compatible API. Base URL, NOT the full completion URL.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Optional provider-specific JSON, e.g. {"thinking":{"type":"disabled"}}
LLM_EXTRA_JSON={}
SYSTEM_PROMPT=你是QQ群里的聊天助手。默认使用中文，友善自然、简明回答；不确定就说明，不编造事实。适合群聊阅读，尽量控制在800字内。

TRIGGER_PREFIX=/ai
HISTORY_TURNS=8
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=500
COOLDOWN_SECONDS=3
MAX_CONCURRENT=3
MAX_INPUT_CHARS=4000
MAX_REPLY_CHARS=2800
MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=90

# 默认一条消息一句话，偶尔补充；每轮最多2条，按发送条数计入配额
RICH_REPLY_ENABLED=true
REPLY_MAX_MESSAGES=2
REPLY_MESSAGE_DELAY_SECONDS=0.8
MEDIA_MAX_ASSETS_PER_GROUP=100
MEDIA_CATALOGUE_LIMIT=40

# Requires an image-capable Chat Completions model, e.g. deepseek-flash.
VISION_ENABLED=true
MAX_IMAGES=3
MAX_IMAGE_BYTES=6291456
IMAGE_TIMEOUT_SECONDS=20

# smart: model decides whether to reply; keywords: names/keywords; off: only @ or /ai.
AUTO_REPLY_MODE=smart
# 可添加 ds、deepseek 等别名；本项保存后在下一条白名单群消息时自动加载
BOT_NAMES=机器人,老哥
# Direct calls such as '机器人出来' bypass automatic reply budgets.
REPLY_ON_NAME=true
AUTO_REPLY_KEYWORDS=帮忙,求助,看图
# Per group; explicit @ /ai bypass automatic reply budgets.
AUTO_CHECK_INTERVAL_SECONDS=20
AUTO_REPLY_COOLDOWN_SECONDS=60
AUTO_MAX_CHECKS_PER_HOUR=60
AUTO_MAX_REPLIES_PER_HOUR=12
# All reply modes receive recent group text, including explicit image requests.
GROUP_CONTEXT_MESSAGES=16
GROUP_CONTEXT_TTL_SECONDS=600

# DeepSeek official Search/Fetch, only for explicit @ /ai / name calls.
SEARCH_ENABLED=false
SEARCH_MAX_TOOL_CALLS=2
SEARCH_MAX_CALLS_PER_HOUR=60
SEARCH_TIMEOUT_SECONDS=20

# Durable memories are scoped to the current group and sender QQ ID.
MEMORY_ENABLED=true
MEMORY_MAX_FACTS_PER_USER=24
MEMORY_INJECT_FACTS=6
MEMORY_FACT_DAYS=180
MEMORY_HISTORY_DAYS=7
MEMORY_EXTRACT_INTERVAL_SECONDS=120
MEMORY_MAX_EXTRACTS_PER_HOUR=40
